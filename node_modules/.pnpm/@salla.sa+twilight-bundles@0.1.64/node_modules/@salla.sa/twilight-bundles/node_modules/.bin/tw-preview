else
  export NODE_PATH="/home/user/Desktop/debuger/tw-drone/node_modules/.pnpm/@salla.sa+twilight-bundles@0.1.64/node_modules/@salla.sa/twilight-bundles/bin/node_modules:/home/user/Desktop/debuger/tw-drone/node_modules/.pnpm/@salla.sa+twilight-bundles@0.1.64/node_modules/@salla.sa/twilight-bundles/node_modules:/home/user/Desktop/debuger/tw-drone/node_modules/.pnpm/@salla.sa+twilight-bundles@0.1.64/node_modules/@salla.sa/node_modules:/home/user/Desktop/debuger/tw-drone/node_modules/.pnpm/@salla.sa+twilight-bundles@0.1.64/node_modules:/home/user/Desktop/debuger/tw-drone/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/tw-preview.js" "$@"
